# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — ELISEOS BOX & FITNESS
# ==============================================================================
# Este archivo contiene las variables de entorno independientes para ELISEOS.
# NO utilizar credenciales de Science in Motion para garantizar aislamiento total.

# --- Firebase Client SDK (Proyecto ELISEOS) ---
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_eliseos
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eliseos-box-fitness.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eliseos-box-fitness
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eliseos-box-fitness.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id_eliseos
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id_eliseos

# --- Sistema Administrativo ELISEOS ---
NEXT_PUBLIC_SCIENCE_CHAGO_URL=http://localhost:3002
NEXT_PUBLIC_SCIENCE_CHAGO_API_KEY=eliseos-admin-api-key-2026

# --- Notificaciones y Códigos OTP (Resend) ---
RESEND_API_KEY=tu_resend_api_key
EMAIL_FROM=Elíseos Box & Fitness <noreply@email.jhernandez.mx>
